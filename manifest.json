{
    "manifest_version": 3,
    "permissions": [
      "storage",
      "webNavigation",
      "tabs"
    ],
    "background": {
      "service_worker": "background.bundle.js"
    },
    "content_scripts": [
      {
        "matches": [
          "*://*/*"
        ],
        "js": [
          "neuralyzer.js",
          "disable-links.js"
        ],
        "css": [
          "neuralyzer.css"
        ]
      }
    ],
    "action": {
      "default_popup": "index.html"
    }
  }